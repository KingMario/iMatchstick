{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-out",
    "rootDir": ".",
    "types": ["node"],
    "jsx": "react-jsx"
  },
  "include": [
    "lib/**/*.ts",
    "components/matchstick/**/*.tsx",
    "components/matchstick/**/*.ts"
  ],
  "exclude": ["node_modules", ".next", "out", ".test-out"]
}
